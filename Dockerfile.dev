FROM python:3.12-slim AS dev

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml constraints.txt README.md ./
COPY autocut ./autocut
RUN pip install --no-cache-dir -c constraints.txt -e ".[dev]"

CMD ["pytest", "-q"]

# The ai extra for the tests marked "ai". torch's PyPI wheel for Linux depends on
# CUDA 13, cuDNN, NCCL and triton, several gigabytes for a container that will only
# ever run on the CPU, so torch and torchvision come from the PyTorch CPU index
# first and the extra then finds them already satisfied. The versions match the
# bounds in pyproject.toml and have to be raised with them.
FROM dev AS ai

RUN pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.13.0+cpu" "torchvision==0.28.0+cpu" \
 && pip install --no-cache-dir -c constraints.txt -e ".[dev,ai]"

CMD ["pytest", "-q", "-m", "ai"]

# The gui extra for the tests marked "gui". PySide6 ships the Qt libraries it needs
# inside the wheel, but not the system libraries Qt itself links against, so the
# offscreen platform plugin still needs libEGL, xkbcommon, fontconfig and the dbus
# client. Nothing here pulls in an X server: QT_QPA_PLATFORM=offscreen renders into
# memory, which is also what CI does.
FROM dev AS gui

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libegl1 libxkbcommon0 libfontconfig1 libdbus-1-3 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir -c constraints.txt -e ".[dev,gui,dev-gui]"

ENV QT_QPA_PLATFORM=offscreen

CMD ["pytest", "-q", "-m", "gui"]
